# Set these in Vercel Project Settings -> Environment Variables (or .env.local for local dev)

# Auto-filled by Vercel when you connect a Postgres storage (Storage tab -> Create Database -> Postgres)
POSTGRES_URL=

# Auto-filled by Vercel when you connect a Blob storage (Storage tab -> Create Database -> Blob)
BLOB_READ_WRITE_TOKEN=

# Pick your own admin password — this is what you type in at /admin to log in
ADMIN_PASSWORD=change-me

# Random long random string, used to sign the admin login session cookie.
# Generate one with: openssl rand -hex 32
AUTH_SECRET=change-me-too
